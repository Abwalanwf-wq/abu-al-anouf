:first-child + html .goog-inline-block { display: inline; }

.recaptcha-checkbox { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-size: 1px; height: 28px; margin: 4px; width: 28px; overflow: visible; outline: 0px; vertical-align: text-bottom; }

.recaptcha-checkbox-border { border-radius: 2px; background-color: rgb(255, 255, 255); border: 2px solid rgb(68, 71, 70); font-size: 1px; height: 24px; position: absolute; width: 24px; z-index: 1; }

.recaptcha-checkbox-borderAnimation { background-image: url("data:image/png;base64,"); background-repeat: no-repeat; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; height: 28px; outline: 0px; position: absolute; width: 28px; }

.recaptcha-checkbox-spinner-gif { border-radius: 2px; background-color: rgb(255, 255, 255); background-size: 24px auto; border: 2px solid rgb(68, 71, 70); height: 24px; right: 0px; position: absolute; top: 0px; width: 24px; }

.recaptcha-checkbox-spinner { background-color: rgb(249, 249, 249); border-width: 6px; border-style: solid; border-color: rgb(77, 144, 254) transparent transparent rgb(77, 144, 254); border-image: none; border-radius: 36px; height: 36px; right: -4px; outline: 0px; position: absolute; top: -4px; width: 36px; box-sizing: border-box; opacity: 0; animation: 2.5s linear 0s infinite normal none paused spinner-spin; transition-duration: 1s; }

@-webkit-keyframes spinner-spin { 
  0% { transform: rotate(0deg); }
  10% { transform: rotate(135deg); }
  25% { transform: rotate(245deg); }
  60% { transform: rotate(700deg); }
  75% { transform: rotate(810deg); }
  100% { transform: rotate(3turn); }
}

@keyframes spinner-spin { 
  0% { transform: rotate(0deg); }
  10% { transform: rotate(135deg); }
  25% { transform: rotate(245deg); }
  60% { transform: rotate(700deg); }
  75% { transform: rotate(810deg); }
  100% { transform: rotate(3turn); }
}

.recaptcha-checkbox-spinner-overlay { content: ""; position: absolute; top: -7px; right: -7px; width: 38px; height: 19px; background-color: rgb(249, 249, 249); animation: 1s linear 0s 1 normal none paused overlay-spin; transform-origin: center bottom; border-radius: 38px 38px 0px 0px; transform: rotate(45deg); opacity: 0; }

@-webkit-keyframes overlay-spin { 
  0% { opacity: 1; transform: rotate(45deg); }
  100% { opacity: 1; transform: rotate(225deg); }
}

@keyframes overlay-spin { 
  0% { opacity: 1; transform: rotate(45deg); }
  100% { opacity: 1; transform: rotate(225deg); }
}

.recaptcha-checkbox-checkmark { background-image: url("data:image/png;base64,"); background-repeat: no-repeat; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; height: 30px; right: -5px; outline: 0px; position: absolute; width: 38px; }

.rc-anchor-dark .recaptcha-checkbox-spinner, .rc-anchor-dark .recaptcha-checkbox-spinner-overlay { background-color: rgb(34, 34, 34); }

.recaptcha-checkbox-hover .recaptcha-checkbox-border, .recaptcha-checkbox-hover .recaptcha-checkbox-spinner-gif { box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 1px inset; border: 2px solid rgb(178, 178, 178); }

.recaptcha-checkbox-focused .recaptcha-checkbox-border, .recaptcha-checkbox-focused .recaptcha-checkbox-spinner-gif { border: 2px solid rgb(77, 144, 254); }

